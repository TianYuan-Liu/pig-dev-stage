11 dict begin
/FontName /Helvetica def
/FontType 1 def
/FontBBox {-156 -218 1000 770} readonly def
/FontMatrix [0.001 0 0 0.001 0 0] readonly def
/PaintType 0 def
/FontInfo 8 dict dup begin
/FullName (Helvetica) readonly def
/BaseFontName (Helvetica) def
/Notice (Copyright \(c\) 1985, 1987, 1989, 1990, 1997, 1998, 1999 Adobe Systems Incorporated.  All Rights Reserved.Helvetica is a trademark of Linotype-Hell AG and/or its subsidiaries.) readonly def
end def
