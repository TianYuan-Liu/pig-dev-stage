    "primaryBorderColor": "#1565c0",
    "primaryTextColor": "#14416e",
    "lineColor": "#6E6E6E",
    "secondaryColor": "#ECECEC",
    "secondaryBorderColor": "#9E9E9E",
    "tertiaryColor": "#F5F5F5",
